{
  "expo": {
    "name": "App Morante",
    "slug": "mobile",
    "scheme": "morantehub",
    "version": "1.6.1",
    "runtimeVersion": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "morante_alerts_v3",
          "sounds": [
            "./assets/levelup.mp3",
            "./assets/order_updated.mp3",
            "./assets/order_cancelled.mp3"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o App Morante acesse a câmera para escanear a chave da NF-e.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que o App Morante acesse o microfone para gravação de áudio.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-mlkit-ocr",
      "expo-sqlite",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morante.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Permitir que o App Morante acesse a câmera para escanear a chave da NF-e.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.morante.mobile",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "__REDACTED_GCP_API_KEY__"
        }
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/dd556f93-9a32-4219-84a2-378b626f09ae",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "dd556f93-9a32-4219-84a2-378b626f09ae"
      }
    },
    "owner": "morante"
  }
}
