{
  "expo": {
    "name": "Equipe Morante",
    "slug": "mobile",
    "scheme": "morantehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matheusmorante.mobile"
    },
    "android": {
      "package": "com.matheusmorante.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
    },
    "extra": {
      "eas": {
        "projectId": "bda44a09-b091-47ec-a0b1-25bc097ac641"
      }
    }
  }
}
