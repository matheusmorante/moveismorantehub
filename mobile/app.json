{
  "expo": {
    "name": "Equipe Morante",
    "slug": "mobile",
    "scheme": "morantehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morante.mobile"
    },
    "android": {
      "package": "com.morante.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "dd556f93-9a32-4219-84a2-378b626f09ae"
      }
    },
    "owner": "morante"
  }
}
