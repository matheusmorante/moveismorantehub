{
  "expo": {
    "name": "Equipe Morante",
    "slug": "mobile",
    "scheme": "morantehub",
    "version": "1.5.0",
    "runtimeVersion": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "morante_alerts_v3",
          "sounds": [
            "./assets/levelup.mp3",
            "./assets/order_updated.mp3",
            "./assets/order_cancelled.mp3"
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morante.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.morante.mobile",
      "versionCode": 25,
      "experimentalLauncherActivity": true,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCROtDtnGmCBnzSiTA2sJTmoEnTsGMf6Qk"
        }
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {},
    "updates": {
      "url": "https://u.expo.dev/dd556f93-9a32-4219-84a2-378b626f09ae",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "dd556f93-9a32-4219-84a2-378b626f09ae"
      }
    },
    "owner": "morante"
  }
}
