# Scanner local do SonarQube Community Build
SONAR_HOST_URL=http://localhost:9001
SONAR_TOKEN=
# Não há flag global de habilitação fiscal. Produção exige a seleção correta do ambiente,
# autorização do operador, confirmação explícita e validações fiscais do fluxo.

# CSC da NFC-e (modelo 65), um par por ambiente fiscal (tpAmb).
# Mantenha IDs e CSCs como Secret em Vercel > Production.
# O QR Code online v3 atual usa chave, versão e tpAmb; ele não consome CSC.
# Nunca exponha esses valores no frontend (VITE_).
NFE_CSC_ID_PRODUCAO=
NFE_CSC_PRODUCAO=
NFE_CSC_ID_HOMOLOGACAO=
NFE_CSC_HOMOLOGACAO=

# Jev/TypeSafe: configurar somente no backend (Vercel/API); nunca prefixar com VITE_.
TYPESAFE_API_KEY=
