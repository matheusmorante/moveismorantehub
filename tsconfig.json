{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@mcp/*": ["src/mcp/*"],
      "@erp/*": ["erp/src/*"]
    }
  },
  "include": ["src/mcp/**/*"],
  "exclude": ["node_modules", "dist"]
}
