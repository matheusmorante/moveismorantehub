    "scripts": {
        "dev": "node ../scripts/run-vercel-env-dev.cjs erp",
        "dev:test": "vite --mode local-test",
        "start": "vite",
        "build": "npm run build:fiscal && vite build",
        "build:fiscal": "node scripts/build-fiscal.cjs && node scripts/check-fiscal-startup.cjs",
        "test:fiscal-startup": "node scripts/build-fiscal.cjs && node scripts/check-fiscal-startup.cjs",
        "build:test": "vite build --mode local-test",
        "lint": "eslint src",
        "preview": "vite preview",
        "test": "vitest",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:coverage:critical": "vitest run --config vitest.config.ts src/pages/utils/productKindRules.test.ts src/pages/App/Products/ProductList/utils/productActivationState.test.ts src/pages/App/Products/ProductList/utils/productCatalogState.test.ts src/pages/App/Products/ProductList/hooks/useProductsActivePersistence.test.ts src/pages/App/Products/ProductList/hooks/useProductsActivationValidation.test.ts --coverage.enabled --coverage.provider=v8 --coverage.include=src/pages/utils/productKindRules.ts --coverage.include=src/pages/App/Products/ProductList/utils/productActivationState.ts --coverage.include=src/pages/App/Products/ProductList/utils/productCatalogState.ts --coverage.include=src/pages/App/Products/ProductList/hooks/useProductsActivationValidation.ts --coverage.reporter=lcov --coverage.reporter=text",
        "test:mutation:critical": "stryker run stryker.critical.config.mjs",
        "test:unit:watch": "vitest --config vitest.config.ts",
        "test:unit:mobile": "vitest run --config vitest.mobile.config.ts",
        "test:unit:mcp": "vitest run --config ../src/mcp/vitest.config.ts",
        "test:agent": "vitest run src/services/aiAgent/__tests__/evaluation/agentDeterministic.test.ts",
        "test:agent:live": "vitest run src/services/aiAgent/__tests__/evaluation/agentLiveAi.test.ts",
        "test:e2e": "playwright test",
        "test:e2e:fiscal:runner": "playwright test --config playwright.fiscal.config.ts",
        "test:e2e:stock": "playwright test --config=playwright.stock.config.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "dev:serve": "vite"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
