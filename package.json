{
  "name": "morante-hub-root",
  "version": "1.0.0",
  "description": "Master Orchestrator for Morante Ecosystem",
  "private": true,
  "scripts": {
    "dev": "npm run build:fiscal --prefix erp && concurrently -k -n ERP,API -c cyan,magenta \"npm run dev:erp\" \"npm run dev:api:serve\"",
    "dev:erp": "npm run dev --prefix erp",
    "dev:api": "npm run build:fiscal --prefix erp && npm run dev:api:serve",
    "dev:api:serve": "npx vercel dev --listen 3000 --yes",
    "dev:erp:test": "npm run dev:test --prefix erp",
    "dev:catalog": "npm run dev --prefix digital-catalog -- -p 3001",
    "dev:all": "concurrently \"npm run dev:erp\" \"npm run dev:catalog\"",
    "install:erp": "npm install --prefix erp",
    "install:catalog": "npm install --prefix digital-catalog",
    "install:all": "npm install --prefix erp && npm install --prefix digital-catalog",
    "mcp:start": "npx tsx src/mcp/index.ts",
    "mcp:stdio": "npx tsx src/mcp/index.ts --stdio",
    "mcp:test": "npm run test:unit --prefix erp -- ../src/mcp/",
    "sefaz:bridge": "npx tsx api/nfe/standaloneServer.ts",
    "quality:sonar": "node scripts/quality/sonar.mjs",
    "quality:ast-grep:scan": "ast-grep scan --config sgconfig.yml erp/src mobile/src digital-catalog/src desktop-print-agent/src api src shared-utils",
    "quality:ast-grep:ci": "ast-grep scan --config sgconfig.yml --min-severity error erp/src mobile/src digital-catalog/src desktop-print-agent/src api src shared-utils",
    "quality:ast-grep:critical": "ast-grep scan --config sgconfig.yml --min-severity error erp/src mobile/src digital-catalog/src desktop-print-agent/src api src shared-utils",
    "test:ast-grep": "ast-grep test --config sgconfig.yml",
    "quality:coverage:critical": "npm run test:coverage:critical --prefix erp",
    "quality:mutation:critical": "npm run test:mutation:critical --prefix erp",
    "test:local:preflight": "node scripts/testing/supabase-local-preflight.cjs",
    "test:db": "node scripts/testing/run-local-supabase-test.cjs db",
    "test:concurrency": "node scripts/testing/run-local-supabase-test.cjs concurrency",
    "test:storage": "node scripts/testing/run-local-supabase-test.cjs storage",
    "test:integration": "node scripts/testing/run-local-supabase-test.cjs concurrency && node scripts/testing/run-local-supabase-test.cjs storage",
    "test:rls": "node scripts/testing/run-local-supabase-test.cjs rls",
    "test:profile-roles": "node scripts/testing/run-local-supabase-test.cjs profile-roles",
    "test:migrations": "node scripts/testing/test-local-migrations.cjs",
    "test:schema-drift": "node scripts/testing/check-schema-drift.cjs",
    "test:local-all": "node scripts/testing/test-local-all.cjs",
    "test:telemetry": "npm run test:unit --prefix erp -- --root .. src/telemetry/__tests__/tracer.test.ts",
    "lint:biome": "npx @biomejs/biome check .",
    "format:biome": "npx @biomejs/biome format --write .",
    "check:knip": "npx knip",
    "security:secrets": "node scripts/security.cjs secrets",
    "security:vuln": "node scripts/security.cjs vuln",
    "security:sbom": "node scripts/security.cjs sbom",
    "advisors": "npx supabase db advisors --local"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@biomejs/biome": "^2.5.14",
    "@sonar/scan": "5.0.1",
    "@types/bwip-js": "^3.2.3",
    "@types/node-forge": "^1.3.14",
    "@vercel/node": "^16.0.1",
    "concurrently": "^9.1.2",
    "knip": "^5.46.2",
    "sharp": "^0.35.4",
    "supabase": "2.118.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/supabase-js": "^2.115.0",
    "@xmldom/xmldom": "^0.8.10",
    "agentic-awesome-skills": "^15.15.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "libxml2-wasm": "^0.7.2",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.1.2",
    "zod": "^4.5.4"
  }
}
