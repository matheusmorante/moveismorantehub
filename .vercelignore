# Only ERP, its shared modules, and backend source are deployment inputs.
/*
!erp
!erp/**
!api
!api/**
!shared-utils
!shared-utils/**
!src
!src/**
!mobile
mobile/*
!mobile/src
!mobile/src/**
!package.json
!package-lock.json
!tsconfig.json
.agents/
.codex/
.github/
.calm/
.git/
digital-catalog/
desktop-print-agent/
automation/
docs/
scripts/
supabase/
tests/
**/node_modules/
**/dist/
**/.vercel/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.log
**/.env*
**/*.apk
**/*.zip
**/*.pdf
# Root scripts stay excluded; these two scripts are required by the ERP build.
!erp/scripts
!erp/scripts/build-fiscal.cjs
!erp/scripts/check-fiscal-startup.cjs
