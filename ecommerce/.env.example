# ==============================================
# CONFIGURAÇÕES DE AMBIENTE - MÓVEIS MORANTE
# ==============================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o arquivo .env.local no Git.

# Supabase Configuration
# Pegue esses valores em: Project Settings > API no console do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_DO_SUPABASE

# URL do site em produção (usado para redirecionamento de auth)
NEXT_PUBLIC_SITE_URL=https://SEU_DOMINIO.vercel.app

# Google Maps / Places API
# Crie uma chave em: https://console.cloud.google.com/
# Ative as APIs: Places API (New) e Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=SUA_GOOGLE_MAPS_API_KEY
